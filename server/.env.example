# --- обязательное ---
PORT=8080
SESSION_SECRET=длинная-случайная-строка
ADMIN_IDS=123456789            # твой Telegram ID, через запятую можно несколько
BOT_TOKEN=                     # от @BotFather
BOT_USERNAME=                  # без @
PUBLIC_URL=https://your-domain # https-адрес сервера, нужен для webhook и Mini App
DB_PATH=/data/bitkong.db       # на Railway — путь внутри Volume

# --- CryptoBot (@CryptoBot → Crypto Pay → Create App) ---
CRYPTOBOT_TOKEN=
CRYPTOBOT_ASSETS=USDT,TON
# вебхук в настройках приложения CryptoBot: PUBLIC_URL + /pay/cryptobot

# --- TON-кошелёк (перевод с комментарием bk<user_id>) ---
TON_WALLET=
TONCENTER_API_KEY=             # необязательно, поднимает лимиты toncenter.com

# --- СБП (эквайринг) ---
SBP_API_URL=                   # эндпоинт создания платежа у провайдера
SBP_API_KEY=
SBP_WEBHOOK_SECRET=            # провайдер шлёт его в заголовке X-Webhook-Secret
# вебхук провайдера: PUBLIC_URL + /pay/sbp

# --- локальная разработка ---
# DEV=1                        # вход без Telegram + тестовые звёзды
